# Nginx site configuration for LostFound Cloud on EC2
# Deploy path on server: /etc/nginx/sites-available/lostfound
#
# Replace <EC2_PUBLIC_IP> with your actual EC2 public IPv4 address.
# If you add a domain name later, replace the server_name line.

server {
    listen 80;
    server_name <EC2_PUBLIC_IP>;

    # Maximum upload size — must match Flask MAX_CONTENT_LENGTH (5MB)
    client_max_body_size 5M;

    # Serve static files directly from Nginx (faster than going through Gunicorn)
    location /static/ {
        alias /home/ubuntu/lostfound-cloud/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Proxy all other requests to Gunicorn via Unix socket
    location / {
        proxy_pass         http://unix:/tmp/lostfound.sock;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # Hide Nginx version from error pages
    server_tokens off;

    # Basic security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
}
