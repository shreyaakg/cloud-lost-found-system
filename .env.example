# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Flask
SECRET_KEY=your-strong-random-secret-key-here
DATABASE_URL=sqlite:///lostfound.db

# Set to "true" only on Render (controls upload path)
RENDER=

# Local development
FLASK_DEBUG=true

# ---------------------------------------------------------------
# AWS S3 — Required for Part 3 (S3 file storage)
# Leave blank to use local file storage fallback.
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=

# AWS credentials for Part 2 EC2 (kept for compatibility)
AWS_S3_BUCKET=
